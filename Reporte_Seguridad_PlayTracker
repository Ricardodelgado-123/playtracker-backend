        }

        * { 
            box-sizing: border-box; 
            margin: 0; 
            padding: 0; 
            font-family: &#39;Segoe UI&#39;, system-ui, sans-serif; 
            user-select: none; 
        }

        body { 
            background-color: var(--bg-base); 
            color: var(--text-main); 
            display: flex; 
            justify-content: center; 
            min-height: 100vh; 
            padding: 20px; 
        }
        
        .app-container { 
            width: 100%; 
            max-width: 1200px; 
            background: var(--bg-panel); 
            border-radius: 12px; 
            overflow: hidden; 
            display: flex; 
            flex-direction: column; 
            min-height: 700px; 
            border: 1px solid #334155; 
        }

        header { 
            background: #0b1120; 
            padding: 20px 30px; 
            display: flex; 
            justify-content: space-between; 
            border-bottom: 1px solid #334155; 
            align-items: center; 
        }

        .logo { 
            font-size: 22px; 
            font-weight: bold; 
        } 

        .logo i { 
            color: var(--primary); 
        }

        .user-controls { 
            display: none; 
            align-items: center; 
            gap: 15px; 
        }

        .btn-logout { 
            background: transparent; 
            border: 1px solid var(--danger); 
            color: var(--danger); 
            padding: 5px 15px; 
            border-radius: 6px; 
            cursor: pointer; 
        }
        
        /* Formularios de Autenticación */
        #login-view { 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center; 
            flex-grow: 1; 
        }

        .login-box { 
            background: var(--bg-card); 
            padding: 30px; 
            border-radius: 12px; 
            width: 350px; 
            border: 1px solid #334155; 
            text-align: center; 
        }

        .login-box input { 
            width: 100%; 
            padding: 12px; 
            margin-bottom: 15px; 
            border-radius: 8px; 
            border: 1px solid #334155; 
            background: var(--bg-panel); 
            color: white; 
            outline: none; 
        }

        .login-box button { 
            width: 100%; 
            padding: 12px; 
            background: var(--primary); 
            color: white; 
            border: none; 
            border-radius: 8px; 
            font-weight: bold; 
            cursor: pointer; 
        }

        .toggle-link { 
            color: var(--primary); 
            cursor: pointer; 
            font-size: 14px; 
            margin-top: 15px; 
            display: block; 
        }
        
        /* Layout del Dashboard */
        #dashboard-view { 
            display: none; 
            padding: 30px; 
            gap: 25px; 
            grid-template-columns: 1fr 1fr; 
            flex-grow: 1; 
            align-items: start; 
        }

        @media (max-width: 900px) { 
            #dashboard-view { 
                grid-template-columns: 1fr; 
            } 
        }

        .card { 
            background: var(--bg-card); 
            border-radius: 12px; 
            padding: 20px; 
            border: 1px solid #334155; 
            display: block; 
            margin-bottom: 25px; 
        }

        .card-header { 
            display: flex; 
            align-items: center; 
            gap: 10px; 
            margin-bottom: 20px; 
            border-bottom: 1px solid #334155; 
            padding-bottom: 15px; 
            font-weight: bold; 
            font-size: 18px; 
        }

        /* Componentes de Formularios */
        .form-group { 
            margin-bottom: 15px; 
            text-align: left; 
        }

        .form-group label { 
            display: block; 
            font-size: 13px; 
            color: var(--text-muted); 
            margin-bottom: 5px; 
        }

        .form-control { 
            width: 100%; 
            padding: 10px; 
            background: var(--bg-panel); 
            color: white; 
            border: 1px solid #334155; 
            border-radius: 6px; 
        }

        .btn-submit { 
            background: var(--accent); 
            color: #000; 
            border: none; 
            padding: 10px 15px; 
            border-radius: 6px; 
            font-weight: bold; 
            cursor: pointer; 
            width: 100%; 
        }

        .btn-danger { 
            background: var(--danger); 
            color: white; 
            border: none; 
            padding: 10px 15px; 
            border-radius: 6px; 
            font-weight: bold; 
            cursor: pointer; 
            width: 100%; 
        }

        .alert-msg { 
            margin-top: 10px; 
            font-size: 13px; 
            font-weight: bold; 
            display: none; 
            padding: 8px; 
            border-radius: 4px; 
        }

        /* Tabla de Posiciones */
        .standings-table { 
            width: 100%; 
            border-collapse: collapse; 
            font-size: 14px; 
            text-align: center; 
        }

        .standings-table th { 
            background-color: #d97706; 
            color: white; 
            padding: 10px; 
            font-weight: bold; 
        }

        .standings-table tr:nth-child(odd) { 
            background-color: #1e293b; 
        }

        .standings-table tr:nth-child(even) { 
            background-color: #0f172a; 
        }

        .standings-table td { 
            padding: 10px; 
            border: 1px solid #334155; 
        }

        .col-equipo { 
            text-align: left; 
            font-weight: bold; 
            color: var(--warning); 
        }

        /* Historial y Predicciones */
        .history-list { 
            display: flex; 
            flex-direction: column; 
            gap: 10px; 
            margin-top: 15px; 
        }

        .history-item { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            background: var(--bg-panel); 
            padding: 10px 15px; 
            border-radius: 8px; 
            border: 1px solid #334155; 
            font-size: 14px; 
        }

        .btn-undo { 
            background: transparent; 
            border: 1px solid var(--danger); 
            color: var(--danger); 
            padding: 5px 10px; 
            border-radius: 4px; 
            cursor: pointer; 
            font-size: 12px; 
        }

        .pred-item { 
            margin-bottom: 15px; 
        }

        .pred-header { 
            display: flex; 
            justify-content: space-between; 
            font-size: 13px; 
            margin-bottom: 5px; 
            font-weight: bold; 
        }

        .pred-bar-bg { 
            width: 100%; 
            background: #334155; 
            height: 10px; 
            border-radius: 5px; 
            overflow: hidden; 
        }

        .pred-bar-fill { 
            height: 100%; 
            background: linear-gradient(90deg, var(--primary), var(--accent)); 
            transition: width 1s ease-in-out; 
        }

        /* Eventos y Calendario */
        .event-item { 
            background: var(--bg-panel); 
            padding: 15px; 
            border-radius: 8px; 
            position: relative; 
            overflow: hidden; 
            margin-bottom: 15px; 
        }

        .event-type-bar { 
            position: absolute; 
            left: 0; 
            top: 0; 
            bottom: 0; 
            width: 5px; 
        }

        .type-entrenamiento { background-color: var(--training); }
        .type-partido { background-color: var(--game); }
        
        .maps-link { 
            color: var(--primary); 
            text-decoration: none; 
            font-weight: bold; 
            background: rgba(59, 130, 246, 0.1); 
            padding: 4px 8px; 
            border-radius: 4px; 
        }

        .attendance-actions { 
            display: flex; 
            gap: 10px; 
            margin-top: 10px; 
        }

        .btn-asisto { 
            background: var(--accent); 
            color: #000; 
            border: none; 
            padding: 8px 15px; 
            border-radius: 6px; 
            cursor: pointer; 
            font-weight: bold; 
        }

        .btn-no-asisto { 
            background: var(--danger); 
            color: white; 
            border: none; 
            padding: 8px 15px; 
            border-radius: 6px; 
            cursor: pointer; 
            font-weight: bold; 
        }

        .coach-stats { 
            display: flex; 
            gap: 15px; 
            font-size: 14px; 
            background: rgba(0,0,0,0.2); 
            padding: 10px; 
            border-radius: 6px; 
            margin-top: 10px; 
        }

        .stat-green { color: var(--accent); font-weight: bold; }
        .stat-red { color: var(--danger); font-weight: bold; }

        /* Pizarra Táctica y Roster CRUD */
        .tabs-container { 
            display: flex; 
            gap: 5px; 
            margin-bottom: 15px; 
            border-bottom: 2px solid #334155; 
            padding-bottom: 5px; 
            overflow-x: auto; 
        }

        .play-tab { 
            background: var(--bg-panel); 
            padding: 8px 15px; 
            border-radius: 6px 6px 0 0; 
            cursor: pointer; 
            font-size: 14px; 
            color: var(--text-muted); 
            transition: 0.2s; 
        }

        .play-tab.active { 
            background: var(--primary); 
            color: white; 
            font-weight: bold; 
        }

        .play-tab-add { 
            background: transparent; 
            color: var(--accent); 
            padding: 8px 12px; 
            cursor: pointer; 
            font-weight: bold; 
            border-radius: 6px; 
        }
        
        .roster-container { 
            display: flex; 
            gap: 10px; 
            margin-bottom: 15px; 
            overflow-x: auto; 
            padding-bottom: 10px; 
            min-height: 45px; 
            align-items: center; 
        }

        .player-chip { 
            display: flex; 
            align-items: center; 
            gap: 8px; 
            background: var(--primary); 
            padding: 5px 12px; 
            border-radius: 20px; 
            font-size: 13px; 
        }

        .player-chip.selected { 
            background: var(--warning); 
            color: #000; 
            font-weight: bold; 
            border: 2px solid white; 
        }

        .action-icon { 
            cursor: pointer; 
            opacity: 0.7; 
            font-size: 12px; 
        } 

        .action-icon:hover { 
            opacity: 1; 
            color: white; 
        }
        
        /* Medio Campo CSS Realista */
        .field-map { 
            width: 100%; 
            height: 320px; 
            background-color: #1a5c31; 
            border: 3px solid white; 
            border-bottom: 8px solid white; 
            position: relative; 
            overflow: hidden; 
            background-image: linear-gradient(to bottom, rgba(255,255,255,0.4) 2px, transparent 2px), linear-gradient(to right, transparent 48%, rgba(255,255,255,0.2) 48%, rgba(255,255,255,0.2) 52%, transparent 52%); 
            background-size: 100% 20%, 100% 100%; 
        }

        .position-node { 
            position: absolute; 
            width: 45px; 
            height: 45px; 
            background: rgba(0,0,0,0.8); 
            border: 2px dashed rgba(255,255,255,0.6); 
            border-radius: 50%; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            color: white; 
            font-size: 11px; 
            font-weight: bold; 
            cursor: grab; 
            text-align: center; 
        }

        .position-node.assigned { 
            background: var(--primary); 
            border: 2px solid white; 
        }
    &lt;/style&gt;
&lt;/head&gt;
