    /* ==============================================
       ROSTER Y PIZARRA TÁCTICA
    ============================================== */
    async function agregarAtletaCoach() {
        const nombre = document.getElementById(&#39;add-jug-nombre&#39;).value;
        const username = document.getElementById(&#39;add-jug-user&#39;).value;
        const password = document.getElementById(&#39;add-jug-pass&#39;).value;
        
        if(!nombre || !username || !password) {
