        &lt;div class=&quot;column-right&quot;&gt;
            
            &lt;!-- TABLA DE POSICIONES --&gt;
            &lt;div class=&quot;card&quot;&gt;
                &lt;div class=&quot;card-header&quot;&gt;&lt;i class=&quot;fa-solid fa-trophy&quot; style=&quot;color:var(--warning);&quot;&gt;&lt;/i&gt; Tabla de Posiciones&lt;/div&gt;
                &lt;div style=&quot;overflow-x: auto;&quot;&gt;
                    &lt;table class=&quot;standings-table&quot;&gt;
                        &lt;thead&gt;
                            &lt;tr&gt;
                                &lt;th&gt;EQUIPO&lt;/th&gt;
                                &lt;th&gt;JJ&lt;/th&gt;
                                &lt;th&gt;JG&lt;/th&gt;
                                &lt;th&gt;JP&lt;/th&gt;
                                &lt;th&gt;PF&lt;/th&gt;
                                &lt;th&gt;PC&lt;/th&gt;
                                &lt;th&gt;DIF&lt;/th&gt;
                                &lt;th&gt;PT&lt;/th&gt;
                            &lt;/tr&gt;
                        &lt;/thead&gt;
                        &lt;tbody id=&quot;tabla-posiciones&quot;&gt;&lt;/tbody&gt;
                    &lt;/table&gt;
                &lt;/div&gt;
            &lt;/div&gt;

            &lt;!-- PREDICCIONES (GRÁFICAS) --&gt;
            &lt;div class=&quot;card&quot;&gt;
                &lt;div class=&quot;card-header&quot;&gt;&lt;i class=&quot;fa-solid fa-chart-line&quot; style=&quot;color:var(--accent);&quot;&gt;&lt;/i&gt; Probabilidad de Campeonato&lt;/div&gt;
                &lt;p style=&quot;font-size:12px; color:var(--text-muted); margin-bottom:15px;&quot;&gt;Cálculo algorítmico basado en Win Rate y Diferencia de Puntos.&lt;/p&gt;
                &lt;div id=&quot;contenedor-predicciones&quot;&gt;&lt;/div&gt;
            &lt;/div&gt;

            &lt;!-- CALENDARIO --&gt;
            &lt;div class=&quot;card&quot;&gt;
                &lt;div class=&quot;card-header&quot;&gt;&lt;i class=&quot;fa-regular fa-calendar-days&quot; style=&quot;color:var(--training);&quot;&gt;&lt;/i&gt; Calendario Oficial&lt;/div&gt;
                &lt;div class=&quot;event-list&quot; id=&quot;calendario-lista&quot;&gt;&lt;/div&gt;
            &lt;/div&gt;
            
        &lt;/div&gt;
