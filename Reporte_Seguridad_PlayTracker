    function switchTab(i) { 
        currentTabIndex = i; 
        selectedPlayer = null; 
        renderPlaybookInterface(); 
    }
    
    function addTab() { 
        if(playbooks.length &gt;= 5) return; 
        playbooks.push({ 
            name: `Jugada ${playbooks.length + 1}`, 
            nodes: JSON.parse(JSON.stringify(playbooks[0].nodes)) 
        }); 
        currentTabIndex = playbooks.length - 1; 
        renderPlaybookInterface(); 
    }
    
    function renameTab(i) { 
        const n = prompt(&quot;Nuevo nombre de la jugada:&quot;, playbooks[i].name); 
        if (n &amp;&amp; n.trim() !== &quot;&quot;) { 
            playbooks[i].name = n.trim(); 
            renderTabs(); 
        } 
    }
    
    function deleteTab(i) { 
        if(confirm(&quot;¿Eliminar esta jugada táctica?&quot;)) { 
            playbooks.splice(i, 1); 
