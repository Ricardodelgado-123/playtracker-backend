        .type-partido { background-color: var(--game); }
        
        .maps-link { 
            color: var(--primary); 
            text-decoration: none; 
            font-weight: bold; 
            background: rgba(59, 130, 246, 0.1); 
            padding: 4px 8px; 
            border-radius: 4px; 
        }

        .attendance-actions { 
            display: flex; 
            gap: 10px; 
            margin-top: 10px; 
        }

        .btn-asisto { 
            background: var(--accent); 
            color: #000; 
            border: none; 
            padding: 8px 15px; 
            border-radius: 6px; 
            cursor: pointer; 
            font-weight: bold; 
        }

        .btn-no-asisto { 
            background: var(--danger); 
            color: white; 
            border: none; 
            padding: 8px 15px; 
            border-radius: 6px; 
            cursor: pointer; 
            font-weight: bold; 
        }

        .coach-stats { 
            display: flex; 
            gap: 15px; 
            font-size: 14px; 
            background: rgba(0,0,0,0.2); 
            padding: 10px; 
            border-radius: 6px; 
            margin-top: 10px; 
        }

        .stat-green { color: var(--accent); font-weight: bold; }
        .stat-red { color: var(--danger); font-weight: bold; }

        /* Pizarra Táctica y Roster CRUD */
        .tabs-container { 
            display: flex; 
            gap: 5px; 
            margin-bottom: 15px; 
            border-bottom: 2px solid #334155; 
            padding-bottom: 5px; 
            overflow-x: auto; 
        }

        .play-tab { 
            background: var(--bg-panel); 
            padding: 8px 15px; 
            border-radius: 6px 6px 0 0; 
            cursor: pointer; 
            font-size: 14px; 
            color: var(--text-muted); 
            transition: 0.2s; 
        }

        .play-tab.active { 
            background: var(--primary); 
            color: white; 
            font-weight: bold; 
        }

        .play-tab-add { 
            background: transparent; 
            color: var(--accent); 
            padding: 8px 12px; 
            cursor: pointer; 
            font-weight: bold; 
            border-radius: 6px; 
        }
        
        .roster-container { 
            display: flex; 
            gap: 10px; 
            margin-bottom: 15px; 
            overflow-x: auto; 
            padding-bottom: 10px; 
            min-height: 45px; 
            align-items: center; 
        }

        .player-chip { 
            display: flex; 
            align-items: center; 
            gap: 8px; 
            background: var(--primary); 
            padding: 5px 12px; 
            border-radius: 20px; 
            font-size: 13px; 
        }

        .player-chip.selected { 
            background: var(--warning); 
            color: #000; 
            font-weight: bold; 
            border: 2px solid white; 
        }

        .action-icon { 
            cursor: pointer; 
            opacity: 0.7; 
            font-size: 12px; 
        } 

        .action-icon:hover { 
            opacity: 1; 
            color: white; 
        }
        
        /* Medio Campo CSS Realista */
        .field-map { 
            width: 100%; 
            height: 320px; 
            background-color: #1a5c31; 
            border: 3px solid white; 
            border-bottom: 8px solid white; 
            position: relative; 
            overflow: hidden; 
            background-image: linear-gradient(to bottom, rgba(255,255,255,0.4) 2px, transparent 2px), linear-gradient(to right, transparent 48%, rgba(255,255,255,0.2) 48%, rgba(255,255,255,0.2) 52%, transparent 52%); 
            background-size: 100% 20%, 100% 100%; 
        }

        .position-node { 
            position: absolute; 
            width: 45px; 
            height: 45px; 
            background: rgba(0,0,0,0.8); 
            border: 2px dashed rgba(255,255,255,0.6); 
