    /* ==============================================
       EVENTOS Y CALENDARIO
    ============================================== */
    async function crearEvento(tipo, panelPrefix) {
        const isCoach = tipo === &#39;Entrenamiento&#39;;
        const msgBox = document.getElementById(`${panelPrefix}-msg`);
        
        const eqLoc = isCoach ? null : document.getElementById(`${panelPrefix}-eq-local`).value;
        const rival = isCoach ? document.getElementById(`${panelPrefix}-tema`).value : document.getElementById(`${panelPrefix}-eq-visita`).value;
        
        if(!rival || !document.getElementById(`${panelPrefix}-fecha`).value) {
            return alert(&quot;Faltan datos por rellenar.&quot;);
        }
        
        const f = new Date(document.getElementById(`${panelPrefix}-fecha`).value);
        const fechaFormat = f.toLocaleDateString(&#39;es-ES&#39;, { day: &#39;2-digit&#39;, month: &#39;short&#39;, hour: &#39;2-digit&#39;, minute: &#39;2-digit&#39; }).replace(&#39;,&#39;, &#39; -&#39;);
        const selMap = document.getElementById(`${panelPrefix}-mapa`);

        try {
            await apiRequest(&#39;/api/eventos&#39;, &#39;POST&#39;, { 
                equipo_local_nombre: eqLoc, 
                rival: rival, 
                tipo: tipo, 
                fecha: fechaFormat, 
                lugar: selMap.options[selMap.selectedIndex].text, 
                linkMapa: selMap.value 
            });
            msgBox.innerText = `¡${tipo} agendado exitosamente!`; 
            msgBox.style.color = &quot;var(--accent)&quot;; 
            msgBox.style.display = &quot;block&quot;;
            cargarEventos();
        } catch (e) { 
            msgBox.innerText = e.error || &quot;Error al agendar evento.&quot;; 
            msgBox.style.color = &quot;var(--danger)&quot;; 
            msgBox.style.display = &quot;block&quot;; 
        }
    }

    async function cargarEventos() {
        try {
            const eventos = await apiRequest(&#39;/api/eventos&#39;);
            const contenedor = document.getElementById(&#39;calendario-lista&#39;); 
            contenedor.innerHTML = &#39;&#39;;
            
            eventos.forEach(ev =&gt; {
                let acts = &#39;&#39;;
                if (activeRole === &#39;Jugador&#39;) {
                    acts = `
                    &lt;div class=&quot;attendance-actions&quot;&gt;
                        &lt;button class=&quot;btn-asisto&quot; onclick=&quot;enviarAsistencia(${ev.id}, true)&quot;&gt;✅ Asisto&lt;/button&gt;
                        &lt;button class=&quot;btn-no-asisto&quot; onclick=&quot;enviarAsistencia(${ev.id}, false)&quot;&gt;❌ Faltaré&lt;/button&gt;
                    &lt;/div&gt;`;
                } else if (activeRole === &#39;Head Coach&#39;) {
                    acts = `
                    &lt;div class=&quot;coach-stats&quot;&gt;
                        &lt;span&gt;Confirmados: &lt;span class=&quot;stat-green&quot;&gt;${ev.stats.asisten}&lt;/span&gt;&lt;/span&gt;
                        &lt;span&gt;Ausentes: &lt;span class=&quot;stat-red&quot;&gt;${ev.stats.faltan}&lt;/span&gt;&lt;/span&gt;
                    &lt;/div&gt;`;
                    
                    // Permitir al coach editar sus entrenamientos
                    if(ev.tipo === &#39;Entrenamiento&#39;) {
                        acts += `
                        &lt;button class=&quot;btn-undo&quot; style=&quot;border-color:var(--warning); color:var(--warning); margin-top:10px; width:100%;&quot; onclick=&quot;editarEventoCoach(${ev.id})&quot;&gt;
                            &lt;i class=&quot;fa-solid fa-pen&quot;&gt;&lt;/i&gt; Editar Info
                        &lt;/button&gt;`;
                    }
                } else if (activeRole === &#39;Admin&#39;) {
                    acts = `
                    &lt;div class=&quot;coach-stats&quot;&gt;
                        &lt;span&gt;Confirmados: &lt;span class=&quot;stat-green&quot;&gt;${ev.stats.asisten}&lt;/span&gt;&lt;/span&gt;
                        &lt;span&gt;Ausentes: &lt;span class=&quot;stat-red&quot;&gt;${ev.stats.faltan}&lt;/span&gt;&lt;/span&gt;
                    &lt;/div&gt;`;
                }
                
                contenedor.innerHTML += `
                    &lt;div class=&quot;event-item&quot;&gt;
                        &lt;div class=&quot;event-type-bar ${ev.tipo === &#39;Partido&#39; ? &#39;type-partido&#39; : &#39;type-entrenamiento&#39;}&quot;&gt;&lt;/div&gt;
                        &lt;div class=&quot;event-title&quot;&gt;${ev.tipo === &#39;Partido&#39; ? ev.equipoLocal+&#39; vs &#39;+ev.rival : ev.rival} &lt;span style=&quot;font-size:12px; color:#cbd5e1; background:rgba(255,255,255,0.1); padding:2px; border-radius:4px;&quot;&gt;${ev.tipo}&lt;/span&gt;&lt;/div&gt;
                        &lt;div class=&quot;event-details&quot;&gt;
                            &lt;span&gt;&lt;i class=&quot;fa-regular fa-clock&quot;&gt;&lt;/i&gt; ${ev.fecha}&lt;/span&gt;
                            &lt;span&gt;&lt;i class=&quot;fa-solid fa-location-dot&quot;&gt;&lt;/i&gt; ${ev.lugar} &lt;a href=&quot;${ev.linkMapa}&quot; target=&quot;_blank&quot; class=&quot;maps-link&quot;&gt;Ver Mapa&lt;/a&gt;&lt;/span&gt;
                        &lt;/div&gt;
                        ${acts}
                    &lt;/div&gt;`;
            });
        } catch(e) {
            console.error(&quot;Error al cargar eventos&quot;);
        }
    }

    async function editarEventoCoach(id) {
        const nFecha = prompt(&quot;Ingresa la nueva Fecha y Hora (Ej. 28 Sep - 18:00):&quot;);
        if(!nFecha) return;
        
        const nLugar = prompt(&quot;Ingresa el nuevo Lugar (Ej. Ecoparque Pilón):&quot;);
