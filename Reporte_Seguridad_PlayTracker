                    &lt;div class=&quot;form-group&quot;&gt;
                        &lt;label&gt;Fecha y Hora&lt;/label&gt;
                        &lt;input type=&quot;datetime-local&quot; id=&quot;coach-fecha&quot; class=&quot;form-control&quot;&gt;
                    &lt;/div&gt;
                    &lt;div class=&quot;form-group&quot;&gt;
                        &lt;label&gt;Sede&lt;/label&gt;
                        &lt;select id=&quot;coach-mapa&quot; class=&quot;form-control&quot;&gt;
                            &lt;option value=&quot;https://maps.app.goo.gl/Armi9rCLYaV3CbnP9?g_st=ac&quot;&gt;Ecoparque Pilón&lt;/option&gt;
                            &lt;option value=&quot;https://maps.app.goo.gl/xeDZp7hknHCGzfLR9?g_st=ac&quot;&gt;Deportivo Oriente&lt;/option&gt;
                            &lt;option value=&quot;https://maps.app.goo.gl/rs8umgYnoJajoi16A?g_st=ac&quot;&gt;Los Pavorreales&lt;/option&gt;
                        &lt;/select&gt;
                    &lt;/div&gt;
                    &lt;button class=&quot;btn-submit&quot; onclick=&quot;crearEvento(&#39;Entrenamiento&#39;, &#39;coach&#39;)&quot; style=&quot;background:var(--training); color:white;&quot;&gt;Agendar Entrenamiento&lt;/button&gt;
                    &lt;p id=&quot;coach-msg&quot; class=&quot;alert-msg&quot;&gt;&lt;/p&gt;
                &lt;/div&gt;
                
                &lt;!-- Pizarra Táctica y Roster CRUD --&gt;
                &lt;div class=&quot;card&quot;&gt;
                    &lt;div class=&quot;card-header&quot;&gt;&lt;i class=&quot;fa-solid fa-chess-board&quot; style=&quot;color:var(--primary);&quot;&gt;&lt;/i&gt; Pizarra Táctica y Roster&lt;/div&gt;
                    &lt;div class=&quot;tabs-container&quot; id=&quot;tabs-container&quot;&gt;&lt;/div&gt;
                    
                    &lt;div style=&quot;display:flex; gap:10px; margin-bottom:15px;&quot;&gt;
                        &lt;input type=&quot;text&quot; id=&quot;add-jug-nombre&quot; class=&quot;form-control&quot; placeholder=&quot;Nombre Atleta&quot;&gt;
                        &lt;input type=&quot;text&quot; id=&quot;add-jug-user&quot; class=&quot;form-control&quot; placeholder=&quot;Usuario&quot;&gt;
