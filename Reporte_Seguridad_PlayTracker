                    &lt;/div&gt;
                &lt;/div&gt;
            &lt;/div&gt;

            &lt;!-- PANEL HEAD COACH --&gt;
            &lt;div id=&quot;panel-coach&quot; style=&quot;display:none;&quot;&gt;
                
                &lt;!-- Programar Entrenamiento --&gt;
                &lt;div class=&quot;card&quot; style=&quot;border-left: 4px solid var(--training);&quot;&gt;
