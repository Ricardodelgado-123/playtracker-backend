    async function editarEventoCoach(id) {
        const nFecha = prompt(&quot;Ingresa la nueva Fecha y Hora (Ej. 28 Sep - 18:00):&quot;);
        if(!nFecha) return;
        
        const nLugar = prompt(&quot;Ingresa el nuevo Lugar (Ej. Ecoparque Pilón):&quot;);
        if(!nLugar) return;
        
        try {
            await apiRequest(`/api/eventos/${id}`, &#39;PUT&#39;, { 
                fecha: nFecha, 
                lugar: nLugar, 
                linkMapa: &quot;https://maps.app.goo.gl/Armi9rCLYaV3CbnP9?g_st=ac&quot; 
            });
            cargarEventos();
        } catch(e) { 
            alert(&quot;Error al editar el evento.&quot;); 
        }
    }

    async function enviarAsistencia(eventoId, asiste) {
        try { 
            await apiRequest(&#39;/api/asistencia&#39;, &#39;POST&#39;, { 
                evento_id: eventoId, 
                asiste: asiste, 
                fatiga: document.getElementById(&#39;fatiga&#39;).value 
            });
            alert(&#39;¡Tu respuesta ha sido enviada al Coach!&#39;); 
            cargarEventos(); 
        } catch(e) {
            alert(&quot;Error al registrar asistencia&quot;);
        }
    }

    /* ==============================================
       ROSTER Y PIZARRA TÁCTICA
    ============================================== */
    async function agregarAtletaCoach() {
        const nombre = document.getElementById(&#39;add-jug-nombre&#39;).value;
        const username = document.getElementById(&#39;add-jug-user&#39;).value;
        const password = document.getElementById(&#39;add-jug-pass&#39;).value;
        
        if(!nombre || !username || !password) {
            return alert(&quot;Por favor, llena todos los campos para agregar al jugador.&quot;);
        }
        
        try {
            await apiRequest(&#39;/api/jugador&#39;, &#39;POST&#39;, { nombre, username, password });
            
            document.getElementById(&#39;add-jug-nombre&#39;).value = &#39;&#39;; 
            document.getElementById(&#39;add-jug-user&#39;).value = &#39;&#39;; 
            document.getElementById(&#39;add-jug-pass&#39;).value = &#39;&#39;;
            
            fetchRoster();
        } catch(e) { 
            alert(&quot;El usuario ya existe en el sistema.&quot;); 
        }
    }

    function renderTabs() {
        const c = document.getElementById(&#39;tabs-container&#39;); 
        c.innerHTML = &#39;&#39;;
        
        playbooks.forEach((pb, i) =&gt; {
            const activeClass = i === currentTabIndex ? &#39;active&#39; : &#39;&#39;;
            c.innerHTML += `
                &lt;div class=&quot;play-tab ${activeClass}&quot; onclick=&quot;switchTab(${i})&quot;&gt;
                    ${pb.name}
                    &lt;i class=&quot;fa-solid fa-pen action-icon&quot; style=&quot;margin-left:8px;&quot; onclick=&quot;event.stopPropagation(); renameTab(${i})&quot; title=&quot;Editar Nombre&quot;&gt;&lt;/i&gt;
                    ${playbooks.length &gt; 1 ? `&lt;i class=&quot;fa-solid fa-xmark action-icon&quot; style=&quot;margin-left:5px; color:var(--danger);&quot; onclick=&quot;event.stopPropagation(); deleteTab(${i})&quot; title=&quot;Eliminar Jugada&quot;&gt;&lt;/i&gt;` : &#39;&#39;}
                &lt;/div&gt;`;
        });
        
        if (playbooks.length &lt; 5) {
            c.innerHTML += `&lt;div class=&quot;play-tab-add&quot; onclick=&quot;addTab()&quot;&gt;+ Nueva Jugada&lt;/div&gt;`;
        }
    }

    function switchTab(i) { 
        currentTabIndex = i; 
        selectedPlayer = null; 
        renderPlaybookInterface(); 
    }
    
    function addTab() { 
        if(playbooks.length &gt;= 5) return; 
        playbooks.push({ 
            name: `Jugada ${playbooks.length + 1}`, 
            nodes: JSON.parse(JSON.stringify(playbooks[0].nodes)) 
        }); 
        currentTabIndex = playbooks.length - 1; 
        renderPlaybookInterface(); 
    }
    
    function renameTab(i) { 
        const n = prompt(&quot;Nuevo nombre de la jugada:&quot;, playbooks[i].name); 
        if (n &amp;&amp; n.trim() !== &quot;&quot;) { 
            playbooks[i].name = n.trim(); 
            renderTabs(); 
        } 
    }
    
    function deleteTab(i) { 
        if(confirm(&quot;¿Eliminar esta jugada táctica?&quot;)) { 
            playbooks.splice(i, 1); 
            currentTabIndex = 0; 
            renderPlaybookInterface(); 
        } 
    }

    async function fetchRoster() { 
        try { 
            fullRoster = await apiRequest(&#39;/api/roster&#39;); 
            renderPlaybookInterface(); 
        } catch(e) {
            console.error(&quot;Error al obtener el roster&quot;);
        } 
    }
    
    function renderPlaybookInterface() { 
        renderTabs(); 
        renderRosterUI(); 
        renderFieldNodes(); 
    }
    
    function renderRosterUI() {
        const c = document.getElementById(&#39;roster-list&#39;); 
        c.innerHTML = &#39;&#39;;
        const assigned = playbooks[currentTabIndex].nodes.map(n =&gt; n.playerName).filter(n =&gt; n);
        
        fullRoster.forEach(j =&gt; {
            if (!assigned.includes(j.nombre)) {
                c.innerHTML += `
                    &lt;div class=&quot;player-chip ${selectedPlayer === j.nombre ? &#39;selected&#39; : &#39;&#39;}&quot;&gt;
                        &lt;span class=&quot;player-name&quot; onclick=&quot;seleccionarJugador(&#39;${j.nombre}&#39;)&quot;&gt;${j.nombre}&lt;/span&gt;
                        &lt;i class=&quot;fa-solid fa-pen action-icon&quot; style=&quot;margin-left:8px;&quot; onclick=&quot;actualizarJugador(${j.id}, &#39;${j.nombre}&#39;)&quot;&gt;&lt;/i&gt;
                        &lt;i class=&quot;fa-solid fa-trash action-icon&quot; style=&quot;margin-left:5px;&quot; onclick=&quot;eliminarJugador(${j.id})&quot;&gt;&lt;/i&gt;
                    &lt;/div&gt;`;
            }
        });
    }

    async function actualizarJugador(id, n) { 
        const nvo = prompt(&quot;Actualizar Nombre del Atleta:&quot;, n); 
        if (nvo &amp;&amp; nvo !== n) { 
            await apiRequest(`/api/jugador/${id}`, &#39;PUT&#39;, { nombre: nvo }); 
            fetchRoster(); 
        } 
    }
    
    async function eliminarJugador(id) { 
        if (confirm(&quot;¿Estás seguro de ELIMINAR a este jugador de la base de datos?&quot;)) { 
            await apiRequest(`/api/jugador/${id}`, &#39;DELETE&#39;); 
            fetchRoster(); 
        } 
    }
    
    function seleccionarJugador(n) { 
        selectedPlayer = selectedPlayer === n ? null : n; 
        renderRosterUI(); 
    }

    function renderFieldNodes() {
        const field = document.getElementById(&#39;field-container&#39;); 
        field.innerHTML = &#39;&#39;;
        
        playbooks[currentTabIndex].nodes.forEach((nData) =&gt; {
            const el = document.createElement(&#39;div&#39;); 
            el.className = nData.playerName ? &#39;position-node assigned&#39; : &#39;position-node&#39;;
            el.style.left = nData.left; 
            el.style.top = nData.top; 
            el.innerText = nData.playerName || nData.defaultName;
            
            el.addEventListener(&#39;click&#39;, () =&gt; {
                if (window.isDraggingNode) return;
                
                if (nData.playerName) { 
                    nData.playerName = null; 
                    selectedPlayer = null; 
                    renderPlaybookInterface(); 
                } 
                else if (selectedPlayer) { 
                    nData.playerName = selectedPlayer; 
                    selectedPlayer = null; 
                    renderPlaybookInterface(); 
                }
            });
            
            makeDraggable(el, nData); 
            field.appendChild(el);
        });
    }

    // Drag &amp; Drop (Mouse y Táctil para Móviles)
    function makeDraggable(el, ref) {
        let p1=0, p2=0, p3=0, p4=0; 
        let dragging = false;
        
        el.onmousedown = startDrag; 
        el.ontouchstart = startDrag;
        
        function startDrag(e) { 
            e.preventDefault(); 
            window.isDraggingNode = false; 
            dragging = false; 
            
            const ev = e.type === &#39;touchstart&#39; ? e.touches[0] : e; 
            p3 = ev.clientX; 
            p4 = ev.clientY; 
            
            document.onmouseup = closeDrag; 
            document.ontouchend = closeDrag; 
            document.onmousemove = dragMove; 
            document.ontouchmove = dragMove; 
        }
        
        function dragMove(e) {
            const ev = e.type === &#39;touchmove&#39; ? e.touches[0] : e;
            
            if (Math.abs(p3 - ev.clientX) &gt; 3 || Math.abs(p4 - ev.clientY) &gt; 3) { 
                dragging = true; 
                window.isDraggingNode = true; 
            }
            
            if (!dragging) return; 
            e.preventDefault();
            
            p1 = p3 - ev.clientX; 
            p2 = p4 - ev.clientY; 
            p3 = ev.clientX; 
            p4 = ev.clientY;
            
            const parent = el.parentElement.getBoundingClientRect();
            let newTop = el.offsetTop - p2;
            let newLeft = el.offsetLeft - p1;
            
            if (newTop &lt; 0) newTop = 0; 
            if (newLeft &lt; 0) newLeft = 0;
            if (newTop + el.offsetHeight &gt; parent.height) newTop = parent.height - el.offsetHeight;
            if (newLeft + el.offsetWidth &gt; parent.width) newLeft = parent.width - el.offsetWidth;
            
            el.style.top = newTop + &quot;px&quot;; 
            el.style.left = newLeft + &quot;px&quot;; 
            ref.top = newTop + &quot;px&quot;; 
            ref.left = newLeft + &quot;px&quot;;
        }
        
        function closeDrag() { 
            document.onmouseup = null; 
            document.onmousemove = null; 
            document.ontouchend = null; 
            document.ontouchmove = null; 
            setTimeout(() =&gt; window.isDraggingNode = false, 50); 
        }
    }

