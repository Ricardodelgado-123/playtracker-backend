                    &lt;div class=&quot;tabs-container&quot; id=&quot;tabs-container&quot;&gt;&lt;/div&gt;
                    
                    &lt;div style=&quot;display:flex; gap:10px; margin-bottom:15px;&quot;&gt;
                        &lt;input type=&quot;text&quot; id=&quot;add-jug-nombre&quot; class=&quot;form-control&quot; placeholder=&quot;Nombre Atleta&quot;&gt;
                        &lt;input type=&quot;text&quot; id=&quot;add-jug-user&quot; class=&quot;form-control&quot; placeholder=&quot;Usuario&quot;&gt;
                        &lt;input type=&quot;password&quot; id=&quot;add-jug-pass&quot; class=&quot;form-control&quot; placeholder=&quot;Clave&quot;&gt;
                        &lt;button class=&quot;btn-submit&quot; onclick=&quot;agregarAtletaCoach()&quot; style=&quot;width:auto;&quot;&gt;&lt;i class=&quot;fa-solid fa-plus&quot;&gt;&lt;/i&gt;&lt;/button&gt;
                    &lt;/div&gt;

                    &lt;div class=&quot;roster-container&quot; id=&quot;roster-list&quot;&gt;&lt;/div&gt;
                    &lt;div class=&quot;field-map&quot; id=&quot;field-container&quot;&gt;&lt;/div&gt;
                &lt;/div&gt;
            &lt;/div&gt;

            &lt;!-- PANEL ATLETA --&gt;
            &lt;div class=&quot;card&quot; id=&quot;panel-atleta&quot; style=&quot;display:none; border-left: 4px solid var(--accent);&quot;&gt;
                &lt;div class=&quot;card-header&quot;&gt;&lt;i class=&quot;fa-solid fa-heart-pulse&quot; style=&quot;color:var(--accent);&quot;&gt;&lt;/i&gt; Estado Físico Diario&lt;/div&gt;
                &lt;select id=&quot;fatiga&quot; class=&quot;form-control&quot; style=&quot;margin-bottom:10px;&quot;&gt;
                    &lt;option value=&quot;1&quot;&gt;Nivel 1: Al 100%&lt;/option&gt;
                    &lt;option value=&quot;2&quot;&gt;Nivel 2: Cansancio general&lt;/option&gt;
                    &lt;option value=&quot;3&quot;&gt;Nivel 3: Molestia muscular leve&lt;/option&gt;
                    &lt;option value=&quot;4&quot;&gt;Nivel 4: Dolor agudo (Riesgo)&lt;/option&gt;
                    &lt;option value=&quot;5&quot;&gt;Nivel 5: LESIÓN&lt;/option&gt;
                &lt;/select&gt;
            &lt;/div&gt;
        &lt;/div&gt;

        &lt;div class=&quot;column-right&quot;&gt;
            
            &lt;!-- TABLA DE POSICIONES --&gt;
            &lt;div class=&quot;card&quot;&gt;
                &lt;div class=&quot;card-header&quot;&gt;&lt;i class=&quot;fa-solid fa-trophy&quot; style=&quot;color:var(--warning);&quot;&gt;&lt;/i&gt; Tabla de Posiciones&lt;/div&gt;
                &lt;div style=&quot;overflow-x: auto;&quot;&gt;
                    &lt;table class=&quot;standings-table&quot;&gt;
                        &lt;thead&gt;
                            &lt;tr&gt;
                                &lt;th&gt;EQUIPO&lt;/th&gt;
                                &lt;th&gt;JJ&lt;/th&gt;
                                &lt;th&gt;JG&lt;/th&gt;
                                &lt;th&gt;JP&lt;/th&gt;
                                &lt;th&gt;PF&lt;/th&gt;
                                &lt;th&gt;PC&lt;/th&gt;
                                &lt;th&gt;DIF&lt;/th&gt;
                                &lt;th&gt;PT&lt;/th&gt;
                            &lt;/tr&gt;
                        &lt;/thead&gt;
                        &lt;tbody id=&quot;tabla-posiciones&quot;&gt;&lt;/tbody&gt;
                    &lt;/table&gt;
                &lt;/div&gt;
            &lt;/div&gt;

            &lt;!-- PREDICCIONES (GRÁFICAS) --&gt;
            &lt;div class=&quot;card&quot;&gt;
                &lt;div class=&quot;card-header&quot;&gt;&lt;i class=&quot;fa-solid fa-chart-line&quot; style=&quot;color:var(--accent);&quot;&gt;&lt;/i&gt; Probabilidad de Campeonato&lt;/div&gt;
                &lt;p style=&quot;font-size:12px; color:var(--text-muted); margin-bottom:15px;&quot;&gt;Cálculo algorítmico basado en Win Rate y Diferencia de Puntos.&lt;/p&gt;
                &lt;div id=&quot;contenedor-predicciones&quot;&gt;&lt;/div&gt;
            &lt;/div&gt;

            &lt;!-- CALENDARIO --&gt;
            &lt;div class=&quot;card&quot;&gt;
                &lt;div class=&quot;card-header&quot;&gt;&lt;i class=&quot;fa-regular fa-calendar-days&quot; style=&quot;color:var(--training);&quot;&gt;&lt;/i&gt; Calendario Oficial&lt;/div&gt;
                &lt;div class=&quot;event-list&quot; id=&quot;calendario-lista&quot;&gt;&lt;/div&gt;
            &lt;/div&gt;
            
        &lt;/div&gt;
    &lt;/div&gt;
&lt;/div&gt;

&lt;script&gt;
    /* ==============================================
       VARIABLES GLOBALES Y CONFIGURACIÓN
    ============================================== */
    let activeRole = &#39;&#39;; 
    let selectedPlayer = null; 
    let fullRoster = []; 
    let equiposLiga = [];
    
    // Playbooks inicializados
    let playbooks = [ 
        { 
            name: &quot;Jugada Base&quot;, 
            nodes: [ 
                { id: &#39;p1&#39;, defaultName: &#39;QB&#39;, playerName: null, left: &#39;45%&#39;, top: &#39;75%&#39; }, 
                { id: &#39;p2&#39;, defaultName: &#39;C&#39;, playerName: null, left: &#39;45%&#39;, top: &#39;50%&#39; }, 
                { id: &#39;p3&#39;, defaultName: &#39;WR1&#39;, playerName: null, left: &#39;10%&#39;, top: &#39;50%&#39; } 
            ] 
        } 
    ];
    let currentTabIndex = 0;

    /* ==============================================
       FUNCIONES DE RED Y AUTENTICACIÓN
    ============================================== */
    async function apiRequest(endpoint, method = &#39;GET&#39;, body = null) {
        const headers = { &#39;Content-Type&#39;: &#39;application/json&#39; };
        const token = localStorage.getItem(&#39;playtracker_token&#39;);
        
        if (token) {
            headers[&#39;Authorization&#39;] = &#39;Bearer &#39; + token;
        }
        
        const res = await fetch(endpoint, { 
            method, 
            headers, 
            body: body ? JSON.stringify(body) : null 
        });
        
        if (!res.ok) throw await res.json();
        return res.json();
    }

    function toggleAuth() {
        const login = document.getElementById(&#39;form-login&#39;); 
        const reg = document.getElementById(&#39;form-register&#39;);
        
        if (login.style.display === &#39;none&#39;) {
            login.style.display = &#39;block&#39;;
            reg.style.display = &#39;none&#39;;
        } else {
            login.style.display = &#39;none&#39;;
            reg.style.display = &#39;block&#39;;
        }
    }

    async function registrarCoach() {
        const nombre = document.getElementById(&#39;reg-nombre&#39;).value;
        const username = document.getElementById(&#39;reg-username&#39;).value;
        const password = document.getElementById(&#39;reg-password&#39;).value;
        const nombreEquipo = document.getElementById(&#39;reg-equipo&#39;).value;
        const msg = document.getElementById(&#39;reg-msg&#39;);
        
        try {
            await apiRequest(&#39;/api/registrar-coach&#39;, &#39;POST&#39;, { username, password, nombre, nombreEquipo });
            msg.innerText = &quot;¡Equipo creado! Ya puedes iniciar sesión.&quot;;
            msg.style.color = &quot;var(--accent)&quot;; 
            msg.style.display = &quot;block&quot;;
            setTimeout(() =&gt; toggleAuth(), 2000);
        } catch (e) {
            msg.innerText = &quot;Error: Usuario o Equipo ya existen.&quot;;
            msg.style.color = &quot;var(--danger)&quot;; 
            msg.style.display = &quot;block&quot;;
        }
    }

    async function iniciarSesion() {
        try {
            const data = await apiRequest(&#39;/api/login&#39;, &#39;POST&#39;, { 
                username: document.getElementById(&#39;log-username&#39;).value, 
                password: document.getElementById(&#39;log-password&#39;).value 
            });
            
            localStorage.setItem(&#39;playtracker_token&#39;, data.token); 
            localStorage.setItem(&#39;playtracker_role&#39;, data.role); 
            localStorage.setItem(&#39;playtracker_name&#39;, data.nombre);
            
            configurarDashboard();
        } catch (e) { 
            const err = document.getElementById(&#39;log-error&#39;);
            err.innerText = &#39;Credenciales inválidas&#39;; 
            err.style.display = &#39;block&#39;; 
        }
    }

    function configurarDashboard() {
        const token = localStorage.getItem(&#39;playtracker_token&#39;); 
        if (!token) return;
        
        activeRole = localStorage.getItem(&#39;playtracker_role&#39;);
        
        document.getElementById(&#39;login-view&#39;).style.display = &#39;none&#39;; 
        document.getElementById(&#39;dashboard-view&#39;).style.display = &#39;grid&#39;; 
        document.getElementById(&#39;user-controls&#39;).style.display = &#39;flex&#39;;
        document.getElementById(&#39;user-name&#39;).innerText = localStorage.getItem(&#39;playtracker_name&#39;) + &#39; (&#39; + activeRole + &#39;)&#39;;

        // Ocultamos todos los paneles primero
        document.getElementById(&#39;panel-admin&#39;).style.display = &#39;none&#39;; 
        document.getElementById(&#39;panel-coach&#39;).style.display = &#39;none&#39;; 
        document.getElementById(&#39;panel-atleta&#39;).style.display = &#39;none&#39;;

        // Mostramos el panel según el rol
        if (activeRole === &#39;Admin&#39;) { 
            document.getElementById(&#39;panel-admin&#39;).style.display = &#39;block&#39;; 
            cargarHistorial(); 
            cargarListaEquiposAdmin(); 
        }
        else if (activeRole === &#39;Head Coach&#39;) { 
            document.getElementById(&#39;panel-coach&#39;).style.display = &#39;block&#39;; 
            fetchRoster(); 
        }
        else { 
            document.getElementById(&#39;panel-atleta&#39;).style.display = &#39;block&#39;; 
        }
        
        // Cargamos los datos compartidos
        cargarPosiciones(); 
        cargarEventos();
        cargarPredicciones();
    }

    /* ==============================================
       INTELIGENCIA DE NEGOCIO (PREDICCIONES)
    ============================================== */
    async function cargarPredicciones() {
        try {
            const preds = await apiRequest(&#39;/api/predicciones&#39;);
            const cont = document.getElementById(&#39;contenedor-predicciones&#39;);
            cont.innerHTML = &#39;&#39;;
            
            preds.forEach(p =&gt; {
                cont.innerHTML += `
                    &lt;div class=&quot;pred-item&quot;&gt;
                        &lt;div class=&quot;pred-header&quot;&gt;
                            &lt;span&gt;${p.equipo}&lt;/span&gt;
                            &lt;span&gt;${p.probabilidad}%&lt;/span&gt;
                        &lt;/div&gt;
                        &lt;div class=&quot;pred-bar-bg&quot;&gt;
                            &lt;div class=&quot;pred-bar-fill&quot; style=&quot;width: ${p.probabilidad}%;&quot;&gt;&lt;/div&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;`;
            });
        } catch(e) { 
            console.error(&quot;Error al cargar predicciones&quot;); 
        }
    }

    /* ==============================================
       POSICIONES Y RESULTADOS
    ============================================== */
    async function cargarPosiciones() {
        try {
            const posiciones = await apiRequest(&#39;/api/posiciones&#39;);
            equiposLiga = posiciones.map(p =&gt; p.equipo);
            const tbody = document.getElementById(&#39;tabla-posiciones&#39;); 
            tbody.innerHTML = &#39;&#39;;
            
            posiciones.forEach(eq =&gt; {
                const difVisual = eq.dif &gt; 0 ? &#39;+&#39; + eq.dif : eq.dif;
                tbody.innerHTML += `
                    &lt;tr&gt;
                        &lt;td class=&quot;col-equipo&quot;&gt;${eq.equipo}&lt;/td&gt;
                        &lt;td&gt;${eq.jj}&lt;/td&gt;
                        &lt;td&gt;${eq.jg}&lt;/td&gt;
                        &lt;td&gt;${eq.jp}&lt;/td&gt;
                        &lt;td&gt;${eq.pf}&lt;/td&gt;
                        &lt;td&gt;${eq.pc}&lt;/td&gt;
                        &lt;td&gt;${difVisual}&lt;/td&gt;
                        &lt;td style=&quot;font-weight:bold; color:var(--accent);&quot;&gt;${eq.pt}&lt;/td&gt;
                    &lt;/tr&gt;`;
            });
            
            if(activeRole === &#39;Admin&#39;) {
                document.querySelectorAll(&#39;.combo-equipos&#39;).forEach(c =&gt; {
                    c.innerHTML = &#39;&#39;; 
                    equiposLiga.forEach(eq =&gt; c.innerHTML += `&lt;option value=&quot;${eq}&quot;&gt;${eq}&lt;/option&gt;`);
                });
            }
        } catch(e) {
            console.error(&quot;Error al cargar las posiciones&quot;);
        }
    }

    async function cargarHistorial() {
        try {
            const historial = await apiRequest(&#39;/api/resultados&#39;);
            const lista = document.getElementById(&#39;lista-historial&#39;); 
            lista.innerHTML = &#39;&#39;;
            
            if(historial.length === 0) { 
                lista.innerHTML = &#39;&lt;p style=&quot;font-size:13px; color:var(--text-muted);&quot;&gt;Sin resultados recientes.&lt;/p&gt;&#39;; 
                return; 
            }
            
            historial.forEach(h =&gt; {
                lista.innerHTML += `
                    &lt;div class=&quot;history-item&quot;&gt;
                        &lt;div&gt;
                            &lt;strong style=&quot;color:var(--warning);&quot;&gt;${h.eq_local} ${h.pts_local}&lt;/strong&gt; 
                            - 
                            &lt;strong&gt;${h.pts_visita} ${h.eq_visita}&lt;/strong&gt;
                        &lt;/div&gt;
                        &lt;button class=&quot;btn-undo&quot; onclick=&quot;revertirResultado(${h.id})&quot;&gt;
                            &lt;i class=&quot;fa-solid fa-rotate-left&quot;&gt;&lt;/i&gt; Deshacer
                        &lt;/button&gt;
                    &lt;/div&gt;`;
            });
        } catch(e) {
            console.error(&quot;Error al cargar el historial&quot;);
        }
    }

    async function registrarResultado() {
        const eqLocal = document.getElementById(&#39;res-eq-local&#39;).value; 
        const eqVisita = document.getElementById(&#39;res-eq-visita&#39;).value;
        const ptsLocal = parseInt(document.getElementById(&#39;res-pts-local&#39;).value); 
        const ptsVisita = parseInt(document.getElementById(&#39;res-pts-visita&#39;).value);
        
        if(eqLocal === eqVisita) {
            return alert(&quot;Un equipo no puede jugar contra sí mismo.&quot;);
        }
        
        try {
            await apiRequest(&#39;/api/resultados&#39;, &#39;POST&#39;, { eqLocal, ptsLocal, eqVisita, ptsVisita });
            document.getElementById(&#39;res-pts-local&#39;).value = &#39;&#39;; 
            document.getElementById(&#39;res-pts-visita&#39;).value = &#39;&#39;;
            
            cargarPosiciones(); 
            cargarHistorial(); 
            cargarPredicciones();
        } catch(e) { 
            alert(&quot;Error al guardar el resultado.&quot;); 
        }
    }

    async function revertirResultado(id) {
        if(confirm(&quot;¿Deshacer este partido y restar puntos a ambos equipos?&quot;)) {
            try { 
                await apiRequest(`/api/resultados/${id}`, &#39;DELETE&#39;); 
                cargarPosiciones(); 
                cargarHistorial(); 
                cargarPredicciones();
            } catch(e) { 
                alert(&quot;Error al revertir el resultado.&quot;); 
            }
        }
    }

    /* ==============================================
       ZONA DE PELIGRO ADMIN
    ============================================== */
    async function cargarListaEquiposAdmin() {
        try {
            const equipos = await apiRequest(&#39;/api/admin/equipos&#39;);
            const lista = document.getElementById(&#39;admin-lista-equipos&#39;); 
            lista.innerHTML = &#39;&#39;;
            
            equipos.forEach(eq =&gt; {
                lista.innerHTML += `
                    &lt;div class=&quot;history-item&quot;&gt;
                        &lt;div&gt;
                            &lt;strong style=&quot;color:var(--primary);&quot;&gt;${eq.equipo}&lt;/strong&gt; &lt;br&gt;
                            &lt;span style=&quot;font-size:12px; color:var(--text-muted);&quot;&gt;Coach: ${eq.coach}&lt;/span&gt;
                        &lt;/div&gt;
                        &lt;button class=&quot;btn-undo&quot; onclick=&quot;eliminarEquipoIndividual(${eq.id}, &#39;${eq.equipo}&#39;)&quot;&gt;
                            &lt;i class=&quot;fa-solid fa-trash&quot;&gt;&lt;/i&gt; Expulsar
                        &lt;/button&gt;
                    &lt;/div&gt;`;
            });
        } catch(e) {
            console.error(&quot;Error al cargar la lista de equipos&quot;);
        }
    }

    async function eliminarEquipoIndividual(id, nombre) {
        if(confirm(`⚠️ ALERTA: ¿Expulsar al equipo ${nombre}? Se borrarán sus jugadores, partidos y puntos en cascada.`)) {
            try { 
                await apiRequest(`/api/admin/equipo/${id}`, &#39;DELETE&#39;); 
                alert(&quot;Equipo eliminado exitosamente.&quot;); 
                configurarDashboard(); 
            } catch(e) {
                alert(&quot;Error al eliminar el equipo.&quot;);
            }
        }
    }

    async function reiniciarTemporada() {
        if(confirm(&quot;⚠️ ALERTA: ¿Reiniciar la tabla de posiciones a CERO? Los equipos y jugadores se mantendrán en el sistema.&quot;)) {
            try { 
                await apiRequest(&#39;/api/admin/reset-posiciones&#39;, &#39;PUT&#39;); 
                alert(&quot;Temporada reiniciada a cero puntos.&quot;); 
                configurarDashboard(); 
            } catch(e) {
                alert(&quot;Error al reiniciar las posiciones.&quot;);
            }
        }
    }

    async function eliminarTodosEquipos() {
        if(confirm(&quot;🚨 ALERTA ROJA: Estás a punto de borrar TODOS los equipos y jugadores para cerrar la temporada. ¿Estás absolutamente seguro?&quot;)) {
            try { 
                await apiRequest(&#39;/api/admin/equipos-todos&#39;, &#39;DELETE&#39;); 
                alert(&quot;Sistema limpiado. Listo para una nueva temporada.&quot;); 
                configurarDashboard(); 
            } catch(e) {
                alert(&quot;Error crítico al limpiar el sistema.&quot;);
            }
        }
    }

    /* ==============================================
       EVENTOS Y CALENDARIO
    ============================================== */
    async function crearEvento(tipo, panelPrefix) {
        const isCoach = tipo === &#39;Entrenamiento&#39;;
        const msgBox = document.getElementById(`${panelPrefix}-msg`);
        
        const eqLoc = isCoach ? null : document.getElementById(`${panelPrefix}-eq-local`).value;
        const rival = isCoach ? document.getElementById(`${panelPrefix}-tema`).value : document.getElementById(`${panelPrefix}-eq-visita`).value;
        
        if(!rival || !document.getElementById(`${panelPrefix}-fecha`).value) {
            return alert(&quot;Faltan datos por rellenar.&quot;);
        }
        
        const f = new Date(document.getElementById(`${panelPrefix}-fecha`).value);
        const fechaFormat = f.toLocaleDateString(&#39;es-ES&#39;, { day: &#39;2-digit&#39;, month: &#39;short&#39;, hour: &#39;2-digit&#39;, minute: &#39;2-digit&#39; }).replace(&#39;,&#39;, &#39; -&#39;);
        const selMap = document.getElementById(`${panelPrefix}-mapa`);

        try {
            await apiRequest(&#39;/api/eventos&#39;, &#39;POST&#39;, { 
                equipo_local_nombre: eqLoc, 
                rival: rival, 
                tipo: tipo, 
                fecha: fechaFormat, 
                lugar: selMap.options[selMap.selectedIndex].text, 
                linkMapa: selMap.value 
            });
            msgBox.innerText = `¡${tipo} agendado exitosamente!`; 
            msgBox.style.color = &quot;var(--accent)&quot;; 
            msgBox.style.display = &quot;block&quot;;
            cargarEventos();
        } catch (e) { 
            msgBox.innerText = e.error || &quot;Error al agendar evento.&quot;; 
            msgBox.style.color = &quot;var(--danger)&quot;; 
            msgBox.style.display = &quot;block&quot;; 
        }
    }

    async function cargarEventos() {
        try {
            const eventos = await apiRequest(&#39;/api/eventos&#39;);
            const contenedor = document.getElementById(&#39;calendario-lista&#39;); 
            contenedor.innerHTML = &#39;&#39;;
            
            eventos.forEach(ev =&gt; {
                let acts = &#39;&#39;;
                if (activeRole === &#39;Jugador&#39;) {
                    acts = `
                    &lt;div class=&quot;attendance-actions&quot;&gt;
                        &lt;button class=&quot;btn-asisto&quot; onclick=&quot;enviarAsistencia(${ev.id}, true)&quot;&gt;✅ Asisto&lt;/button&gt;
                        &lt;button class=&quot;btn-no-asisto&quot; onclick=&quot;enviarAsistencia(${ev.id}, false)&quot;&gt;❌ Faltaré&lt;/button&gt;
                    &lt;/div&gt;`;
                } else if (activeRole === &#39;Head Coach&#39;) {
                    acts = `
                    &lt;div class=&quot;coach-stats&quot;&gt;
                        &lt;span&gt;Confirmados: &lt;span class=&quot;stat-green&quot;&gt;${ev.stats.asisten}&lt;/span&gt;&lt;/span&gt;
                        &lt;span&gt;Ausentes: &lt;span class=&quot;stat-red&quot;&gt;${ev.stats.faltan}&lt;/span&gt;&lt;/span&gt;
                    &lt;/div&gt;`;
                    
                    // Permitir al coach editar sus entrenamientos
                    if(ev.tipo === &#39;Entrenamiento&#39;) {
                        acts += `
                        &lt;button class=&quot;btn-undo&quot; style=&quot;border-color:var(--warning); color:var(--warning); margin-top:10px; width:100%;&quot; onclick=&quot;editarEventoCoach(${ev.id})&quot;&gt;
                            &lt;i class=&quot;fa-solid fa-pen&quot;&gt;&lt;/i&gt; Editar Info
                        &lt;/button&gt;`;
                    }
                } else if (activeRole === &#39;Admin&#39;) {
                    acts = `
                    &lt;div class=&quot;coach-stats&quot;&gt;
                        &lt;span&gt;Confirmados: &lt;span class=&quot;stat-green&quot;&gt;${ev.stats.asisten}&lt;/span&gt;&lt;/span&gt;
                        &lt;span&gt;Ausentes: &lt;span class=&quot;stat-red&quot;&gt;${ev.stats.faltan}&lt;/span&gt;&lt;/span&gt;
                    &lt;/div&gt;`;
                }
                
                contenedor.innerHTML += `
                    &lt;div class=&quot;event-item&quot;&gt;
                        &lt;div class=&quot;event-type-bar ${ev.tipo === &#39;Partido&#39; ? &#39;type-partido&#39; : &#39;type-entrenamiento&#39;}&quot;&gt;&lt;/div&gt;
                        &lt;div class=&quot;event-title&quot;&gt;${ev.tipo === &#39;Partido&#39; ? ev.equipoLocal+&#39; vs &#39;+ev.rival : ev.rival} &lt;span style=&quot;font-size:12px; color:#cbd5e1; background:rgba(255,255,255,0.1); padding:2px; border-radius:4px;&quot;&gt;${ev.tipo}&lt;/span&gt;&lt;/div&gt;
                        &lt;div class=&quot;event-details&quot;&gt;
                            &lt;span&gt;&lt;i class=&quot;fa-regular fa-clock&quot;&gt;&lt;/i&gt; ${ev.fecha}&lt;/span&gt;
                            &lt;span&gt;&lt;i class=&quot;fa-solid fa-location-dot&quot;&gt;&lt;/i&gt; ${ev.lugar} &lt;a href=&quot;${ev.linkMapa}&quot; target=&quot;_blank&quot; class=&quot;maps-link&quot;&gt;Ver Mapa&lt;/a&gt;&lt;/span&gt;
                        &lt;/div&gt;
                        ${acts}
                    &lt;/div&gt;`;
            });
        } catch(e) {
            console.error(&quot;Error al cargar eventos&quot;);
        }
    }

    async function editarEventoCoach(id) {
        const nFecha = prompt(&quot;Ingresa la nueva Fecha y Hora (Ej. 28 Sep - 18:00):&quot;);
        if(!nFecha) return;
        
        const nLugar = prompt(&quot;Ingresa el nuevo Lugar (Ej. Ecoparque Pilón):&quot;);
        if(!nLugar) return;
        
        try {
            await apiRequest(`/api/eventos/${id}`, &#39;PUT&#39;, { 
                fecha: nFecha, 
                lugar: nLugar, 
                linkMapa: &quot;https://maps.app.goo.gl/Armi9rCLYaV3CbnP9?g_st=ac&quot; 
            });
            cargarEventos();
        } catch(e) { 
            alert(&quot;Error al editar el evento.&quot;); 
        }
    }

    async function enviarAsistencia(eventoId, asiste) {
        try { 
            await apiRequest(&#39;/api/asistencia&#39;, &#39;POST&#39;, { 
                evento_id: eventoId, 
                asiste: asiste, 
                fatiga: document.getElementById(&#39;fatiga&#39;).value 
            });
            alert(&#39;¡Tu respuesta ha sido enviada al Coach!&#39;); 
            cargarEventos(); 
        } catch(e) {
            alert(&quot;Error al registrar asistencia&quot;);
        }
    }

    /* ==============================================
       ROSTER Y PIZARRA TÁCTICA
    ============================================== */
    async function agregarAtletaCoach() {
        const nombre = document.getElementById(&#39;add-jug-nombre&#39;).value;
        const username = document.getElementById(&#39;add-jug-user&#39;).value;
        const password = document.getElementById(&#39;add-jug-pass&#39;).value;
        
        if(!nombre || !username || !password) {
            return alert(&quot;Por favor, llena todos los campos para agregar al jugador.&quot;);
        }
        
        try {
            await apiRequest(&#39;/api/jugador&#39;, &#39;POST&#39;, { nombre, username, password });
            
            document.getElementById(&#39;add-jug-nombre&#39;).value = &#39;&#39;; 
            document.getElementById(&#39;add-jug-user&#39;).value = &#39;&#39;; 
            document.getElementById(&#39;add-jug-pass&#39;).value = &#39;&#39;;
            
            fetchRoster();
        } catch(e) { 
            alert(&quot;El usuario ya existe en el sistema.&quot;); 
        }
    }

    function renderTabs() {
        const c = document.getElementById(&#39;tabs-container&#39;); 
        c.innerHTML = &#39;&#39;;
        
        playbooks.forEach((pb, i) =&gt; {
            const activeClass = i === currentTabIndex ? &#39;active&#39; : &#39;&#39;;
            c.innerHTML += `
                &lt;div class=&quot;play-tab ${activeClass}&quot; onclick=&quot;switchTab(${i})&quot;&gt;
                    ${pb.name}
                    &lt;i class=&quot;fa-solid fa-pen action-icon&quot; style=&quot;margin-left:8px;&quot; onclick=&quot;event.stopPropagation(); renameTab(${i})&quot; title=&quot;Editar Nombre&quot;&gt;&lt;/i&gt;
                    ${playbooks.length &gt; 1 ? `&lt;i class=&quot;fa-solid fa-xmark action-icon&quot; style=&quot;margin-left:5px; color:var(--danger);&quot; onclick=&quot;event.stopPropagation(); deleteTab(${i})&quot; title=&quot;Eliminar Jugada&quot;&gt;&lt;/i&gt;` : &#39;&#39;}
                &lt;/div&gt;`;
        });
        
        if (playbooks.length &lt; 5) {
            c.innerHTML += `&lt;div class=&quot;play-tab-add&quot; onclick=&quot;addTab()&quot;&gt;+ Nueva Jugada&lt;/div&gt;`;
        }
    }

    function switchTab(i) { 
        currentTabIndex = i; 
        selectedPlayer = null; 
        renderPlaybookInterface(); 
    }
    
    function addTab() { 
