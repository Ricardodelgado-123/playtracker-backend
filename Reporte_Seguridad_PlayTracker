                        &lt;/div&gt;
                        &lt;button class=&quot;btn-undo&quot; onclick=&quot;revertirResultado(${h.id})&quot;&gt;
                            &lt;i class=&quot;fa-solid fa-rotate-left&quot;&gt;&lt;/i&gt; Deshacer
                        &lt;/button&gt;
                    &lt;/div&gt;`;
