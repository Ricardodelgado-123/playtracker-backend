&lt;script&gt;
    /* ==============================================
       VARIABLES GLOBALES Y CONFIGURACIÓN
    ============================================== */
    let activeRole = &#39;&#39;; 
    let selectedPlayer = null; 
    let fullRoster = []; 
    let equiposLiga = [];
    
    // Playbooks inicializados
    let playbooks = [ 
        { 
            name: &quot;Jugada Base&quot;, 
            nodes: [ 
                { id: &#39;p1&#39;, defaultName: &#39;QB&#39;, playerName: null, left: &#39;45%&#39;, top: &#39;75%&#39; }, 
                { id: &#39;p2&#39;, defaultName: &#39;C&#39;, playerName: null, left: &#39;45%&#39;, top: &#39;50%&#39; }, 
                { id: &#39;p3&#39;, defaultName: &#39;WR1&#39;, playerName: null, left: &#39;10%&#39;, top: &#39;50%&#39; } 
            ] 
        } 
    ];
    let currentTabIndex = 0;

    /* ==============================================
       FUNCIONES DE RED Y AUTENTICACIÓN
    ============================================== */
    async function apiRequest(endpoint, method = &#39;GET&#39;, body = null) {
        const headers = { &#39;Content-Type&#39;: &#39;application/json&#39; };
        const token = localStorage.getItem(&#39;playtracker_token&#39;);
        
        if (token) {
            headers[&#39;Authorization&#39;] = &#39;Bearer &#39; + token;
        }
        
        const res = await fetch(endpoint, { 
            method, 
            headers, 
            body: body ? JSON.stringify(body) : null 
        });
        
        if (!res.ok) throw await res.json();
        return res.json();
    }

    function toggleAuth() {
        const login = document.getElementById(&#39;form-login&#39;); 
        const reg = document.getElementById(&#39;form-register&#39;);
        
        if (login.style.display === &#39;none&#39;) {
            login.style.display = &#39;block&#39;;
            reg.style.display = &#39;none&#39;;
        } else {
            login.style.display = &#39;none&#39;;
            reg.style.display = &#39;block&#39;;
        }
    }

    async function registrarCoach() {
        const nombre = document.getElementById(&#39;reg-nombre&#39;).value;
        const username = document.getElementById(&#39;reg-username&#39;).value;
        const password = document.getElementById(&#39;reg-password&#39;).value;
        const nombreEquipo = document.getElementById(&#39;reg-equipo&#39;).value;
        const msg = document.getElementById(&#39;reg-msg&#39;);
        
        try {
            await apiRequest(&#39;/api/registrar-coach&#39;, &#39;POST&#39;, { username, password, nombre, nombreEquipo });
            msg.innerText = &quot;¡Equipo creado! Ya puedes iniciar sesión.&quot;;
            msg.style.color = &quot;var(--accent)&quot;; 
            msg.style.display = &quot;block&quot;;
            setTimeout(() =&gt; toggleAuth(), 2000);
        } catch (e) {
            msg.innerText = &quot;Error: Usuario o Equipo ya existen.&quot;;
            msg.style.color = &quot;var(--danger)&quot;; 
            msg.style.display = &quot;block&quot;;
        }
    }

    async function iniciarSesion() {
        try {
            const data = await apiRequest(&#39;/api/login&#39;, &#39;POST&#39;, { 
                username: document.getElementById(&#39;log-username&#39;).value, 
                password: document.getElementById(&#39;log-password&#39;).value 
            });
            
            localStorage.setItem(&#39;playtracker_token&#39;, data.token); 
            localStorage.setItem(&#39;playtracker_role&#39;, data.role); 
            localStorage.setItem(&#39;playtracker_name&#39;, data.nombre);
            
            configurarDashboard();
        } catch (e) { 
            const err = document.getElementById(&#39;log-error&#39;);
            err.innerText = &#39;Credenciales inválidas&#39;; 
            err.style.display = &#39;block&#39;; 
        }
    }

    function configurarDashboard() {
        const token = localStorage.getItem(&#39;playtracker_token&#39;); 
        if (!token) return;
        
        activeRole = localStorage.getItem(&#39;playtracker_role&#39;);
        
        document.getElementById(&#39;login-view&#39;).style.display = &#39;none&#39;; 
        document.getElementById(&#39;dashboard-view&#39;).style.display = &#39;grid&#39;; 
        document.getElementById(&#39;user-controls&#39;).style.display = &#39;flex&#39;;
        document.getElementById(&#39;user-name&#39;).innerText = localStorage.getItem(&#39;playtracker_name&#39;) + &#39; (&#39; + activeRole + &#39;)&#39;;

        // Ocultamos todos los paneles primero
        document.getElementById(&#39;panel-admin&#39;).style.display = &#39;none&#39;; 
        document.getElementById(&#39;panel-coach&#39;).style.display = &#39;none&#39;; 
        document.getElementById(&#39;panel-atleta&#39;).style.display = &#39;none&#39;;

        // Mostramos el panel según el rol
        if (activeRole === &#39;Admin&#39;) { 
            document.getElementById(&#39;panel-admin&#39;).style.display = &#39;block&#39;; 
            cargarHistorial(); 
            cargarListaEquiposAdmin(); 
        }
        else if (activeRole === &#39;Head Coach&#39;) { 
            document.getElementById(&#39;panel-coach&#39;).style.display = &#39;block&#39;; 
            fetchRoster(); 
        }
        else { 
            document.getElementById(&#39;panel-atleta&#39;).style.display = &#39;block&#39;; 
        }
        
        // Cargamos los datos compartidos
        cargarPosiciones(); 
        cargarEventos();
        cargarPredicciones();
    }

    /* ==============================================
       INTELIGENCIA DE NEGOCIO (PREDICCIONES)
    ============================================== */
    async function cargarPredicciones() {
        try {
            const preds = await apiRequest(&#39;/api/predicciones&#39;);
            const cont = document.getElementById(&#39;contenedor-predicciones&#39;);
            cont.innerHTML = &#39;&#39;;
            
            preds.forEach(p =&gt; {
                cont.innerHTML += `
                    &lt;div class=&quot;pred-item&quot;&gt;
                        &lt;div class=&quot;pred-header&quot;&gt;
                            &lt;span&gt;${p.equipo}&lt;/span&gt;
                            &lt;span&gt;${p.probabilidad}%&lt;/span&gt;
                        &lt;/div&gt;
                        &lt;div class=&quot;pred-bar-bg&quot;&gt;
                            &lt;div class=&quot;pred-bar-fill&quot; style=&quot;width: ${p.probabilidad}%;&quot;&gt;&lt;/div&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;`;
            });
        } catch(e) { 
            console.error(&quot;Error al cargar predicciones&quot;); 
        }
    }

    /* ==============================================
       POSICIONES Y RESULTADOS
    ============================================== */
    async function cargarPosiciones() {
        try {
            const posiciones = await apiRequest(&#39;/api/posiciones&#39;);
            equiposLiga = posiciones.map(p =&gt; p.equipo);
            const tbody = document.getElementById(&#39;tabla-posiciones&#39;); 
            tbody.innerHTML = &#39;&#39;;
            
            posiciones.forEach(eq =&gt; {
                const difVisual = eq.dif &gt; 0 ? &#39;+&#39; + eq.dif : eq.dif;
                tbody.innerHTML += `
                    &lt;tr&gt;
                        &lt;td class=&quot;col-equipo&quot;&gt;${eq.equipo}&lt;/td&gt;
                        &lt;td&gt;${eq.jj}&lt;/td&gt;
                        &lt;td&gt;${eq.jg}&lt;/td&gt;
                        &lt;td&gt;${eq.jp}&lt;/td&gt;
                        &lt;td&gt;${eq.pf}&lt;/td&gt;
                        &lt;td&gt;${eq.pc}&lt;/td&gt;
                        &lt;td&gt;${difVisual}&lt;/td&gt;
                        &lt;td style=&quot;font-weight:bold; color:var(--accent);&quot;&gt;${eq.pt}&lt;/td&gt;
                    &lt;/tr&gt;`;
            });
            
            if(activeRole === &#39;Admin&#39;) {
                document.querySelectorAll(&#39;.combo-equipos&#39;).forEach(c =&gt; {
                    c.innerHTML = &#39;&#39;; 
