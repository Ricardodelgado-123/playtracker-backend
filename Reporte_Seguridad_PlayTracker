    function seleccionarJugador(n) { 
        selectedPlayer = selectedPlayer === n ? null : n; 
        renderRosterUI(); 
    }

    function renderFieldNodes() {
        const field = document.getElementById(&#39;field-container&#39;); 
        field.innerHTML = &#39;&#39;;
        
        playbooks[currentTabIndex].nodes.forEach((nData) =&gt; {
            const el = document.createElement(&#39;div&#39;); 
            el.className = nData.playerName ? &#39;position-node assigned&#39; : &#39;position-node&#39;;
            el.style.left = nData.left; 
            el.style.top = nData.top; 
            el.innerText = nData.playerName || nData.defaultName;
            
            el.addEventListener(&#39;click&#39;, () =&gt; {
                if (window.isDraggingNode) return;
                
                if (nData.playerName) { 
                    nData.playerName = null; 
                    selectedPlayer = null; 
                    renderPlaybookInterface(); 
                } 
                else if (selectedPlayer) { 
                    nData.playerName = selectedPlayer; 
                    selectedPlayer = null; 
                    renderPlaybookInterface(); 
                }
            });
            
            makeDraggable(el, nData); 
            field.appendChild(el);
        });
    }

    // Drag &amp; Drop (Mouse y Táctil para Móviles)
    function makeDraggable(el, ref) {
        let p1=0, p2=0, p3=0, p4=0; 
        let dragging = false;
        
        el.onmousedown = startDrag; 
        el.ontouchstart = startDrag;
        
        function startDrag(e) { 
            e.preventDefault(); 
            window.isDraggingNode = false; 
            dragging = false; 
            
            const ev = e.type === &#39;touchstart&#39; ? e.touches[0] : e; 
            p3 = ev.clientX; 
            p4 = ev.clientY; 
            
            document.onmouseup = closeDrag; 
            document.ontouchend = closeDrag; 
            document.onmousemove = dragMove; 
            document.ontouchmove = dragMove; 
        }
        
        function dragMove(e) {
            const ev = e.type === &#39;touchmove&#39; ? e.touches[0] : e;
            
            if (Math.abs(p3 - ev.clientX) &gt; 3 || Math.abs(p4 - ev.clientY) &gt; 3) { 
                dragging = true; 
                window.isDraggingNode = true; 
            }
            
            if (!dragging) return; 
            e.preventDefault();
            
            p1 = p3 - ev.clientX; 
            p2 = p4 - ev.clientY; 
            p3 = ev.clientX; 
            p4 = ev.clientY;
            
            const parent = el.parentElement.getBoundingClientRect();
            let newTop = el.offsetTop - p2;
            let newLeft = el.offsetLeft - p1;
            
            if (newTop &lt; 0) newTop = 0; 
            if (newLeft &lt; 0) newLeft = 0;
            if (newTop + el.offsetHeight &gt; parent.height) newTop = parent.height - el.offsetHeight;
            if (newLeft + el.offsetWidth &gt; parent.width) newLeft = parent.width - el.offsetWidth;
            
            el.style.top = newTop + &quot;px&quot;; 
            el.style.left = newLeft + &quot;px&quot;; 
            ref.top = newTop + &quot;px&quot;; 
            ref.left = newLeft + &quot;px&quot;;
        }
        
        function closeDrag() { 
            document.onmouseup = null; 
            document.onmousemove = null; 
            document.ontouchend = null; 
            document.ontouchmove = null; 
            setTimeout(() =&gt; window.isDraggingNode = false, 50); 
        }
    }

