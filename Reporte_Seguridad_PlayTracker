            &lt;/div&gt;

            &lt;!-- PANEL ATLETA --&gt;
            &lt;div class=&quot;card&quot; id=&quot;panel-atleta&quot; style=&quot;display:none; border-left: 4px solid var(--accent);&quot;&gt;
