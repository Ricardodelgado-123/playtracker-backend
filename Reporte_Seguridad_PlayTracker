            color: white; 
            border: none; 
            border-radius: 8px; 
            font-weight: bold; 
            cursor: pointer; 
        }

        .toggle-link { 
            color: var(--primary); 
            cursor: pointer; 
            font-size: 14px; 
            margin-top: 15px; 
            display: block; 
        }
        
        /* Layout del Dashboard */
        #dashboard-view { 
            display: none; 
            padding: 30px; 
            gap: 25px; 
            grid-template-columns: 1fr 1fr; 
            flex-grow: 1; 
            align-items: start; 
        }

        @media (max-width: 900px) { 
            #dashboard-view { 
                grid-template-columns: 1fr; 
            } 
        }

        .card { 
            background: var(--bg-card); 
            border-radius: 12px; 
            padding: 20px; 
            border: 1px solid #334155; 
            display: block; 
            margin-bottom: 25px; 
        }

        .card-header { 
            display: flex; 
            align-items: center; 
            gap: 10px; 
            margin-bottom: 20px; 
            border-bottom: 1px solid #334155; 
            padding-bottom: 15px; 
            font-weight: bold; 
            font-size: 18px; 
        }

        /* Componentes de Formularios */
        .form-group { 
            margin-bottom: 15px; 
            text-align: left; 
        }

        .form-group label { 
            display: block; 
            font-size: 13px; 
            color: var(--text-muted); 
            margin-bottom: 5px; 
        }

        .form-control { 
            width: 100%; 
            padding: 10px; 
            background: var(--bg-panel); 
            color: white; 
            border: 1px solid #334155; 
            border-radius: 6px; 
        }

        .btn-submit { 
            background: var(--accent); 
            color: #000; 
            border: none; 
            padding: 10px 15px; 
            border-radius: 6px; 
            font-weight: bold; 
            cursor: pointer; 
            width: 100%; 
        }

        .btn-danger { 
            background: var(--danger); 
            color: white; 
            border: none; 
            padding: 10px 15px; 
            border-radius: 6px; 
            font-weight: bold; 
            cursor: pointer; 
            width: 100%; 
        }

        .alert-msg { 
            margin-top: 10px; 
            font-size: 13px; 
            font-weight: bold; 
            display: none; 
            padding: 8px; 
            border-radius: 4px; 
        }

        /* Tabla de Posiciones */
        .standings-table { 
            width: 100%; 
            border-collapse: collapse; 
            font-size: 14px; 
            text-align: center; 
        }

        .standings-table th { 
            background-color: #d97706; 
            color: white; 
            padding: 10px; 
            font-weight: bold; 
        }

        .standings-table tr:nth-child(odd) { 
            background-color: #1e293b; 
        }

        .standings-table tr:nth-child(even) { 
            background-color: #0f172a; 
        }

        .standings-table td { 
            padding: 10px; 
            border: 1px solid #334155; 
        }

        .col-equipo { 
            text-align: left; 
            font-weight: bold; 
            color: var(--warning); 
        }

        /* Historial y Predicciones */
        .history-list { 
            display: flex; 
            flex-direction: column; 
            gap: 10px; 
            margin-top: 15px; 
        }

        .history-item { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            background: var(--bg-panel); 
            padding: 10px 15px; 
            border-radius: 8px; 
            border: 1px solid #334155; 
            font-size: 14px; 
        }

        .btn-undo { 
            background: transparent; 
            border: 1px solid var(--danger); 
            color: var(--danger); 
            padding: 5px 10px; 
            border-radius: 4px; 
            cursor: pointer; 
            font-size: 12px; 
        }

        .pred-item { 
            margin-bottom: 15px; 
        }

        .pred-header { 
            display: flex; 
            justify-content: space-between; 
            font-size: 13px; 
            margin-bottom: 5px; 
            font-weight: bold; 
        }

        .pred-bar-bg { 
            width: 100%; 
            background: #334155; 
            height: 10px; 
            border-radius: 5px; 
            overflow: hidden; 
        }

        .pred-bar-fill { 
            height: 100%; 
            background: linear-gradient(90deg, var(--primary), var(--accent)); 
            transition: width 1s ease-in-out; 
        }

        /* Eventos y Calendario */
        .event-item { 
            background: var(--bg-panel); 
            padding: 15px; 
            border-radius: 8px; 
            position: relative; 
            overflow: hidden; 
            margin-bottom: 15px; 
        }

        .event-type-bar { 
            position: absolute; 
            left: 0; 
            top: 0; 
            bottom: 0; 
            width: 5px; 
        }

        .type-entrenamiento { background-color: var(--training); }
        .type-partido { background-color: var(--game); }
        
        .maps-link { 
            color: var(--primary); 
            text-decoration: none; 
            font-weight: bold; 
            background: rgba(59, 130, 246, 0.1); 
            padding: 4px 8px; 
            border-radius: 4px; 
        }

        .attendance-actions { 
            display: flex; 
            gap: 10px; 
            margin-top: 10px; 
        }

        .btn-asisto { 
            background: var(--accent); 
            color: #000; 
            border: none; 
            padding: 8px 15px; 
            border-radius: 6px; 
            cursor: pointer; 
            font-weight: bold; 
        }

        .btn-no-asisto { 
            background: var(--danger); 
            color: white; 
            border: none; 
            padding: 8px 15px; 
            border-radius: 6px; 
            cursor: pointer; 
            font-weight: bold; 
        }

        .coach-stats { 
            display: flex; 
            gap: 15px; 
            font-size: 14px; 
            background: rgba(0,0,0,0.2); 
            padding: 10px; 
            border-radius: 6px; 
            margin-top: 10px; 
        }

        .stat-green { color: var(--accent); font-weight: bold; }
        .stat-red { color: var(--danger); font-weight: bold; }

        /* Pizarra Táctica y Roster CRUD */
        .tabs-container { 
            display: flex; 
            gap: 5px; 
            margin-bottom: 15px; 
            border-bottom: 2px solid #334155; 
            padding-bottom: 5px; 
            overflow-x: auto; 
        }

        .play-tab { 
            background: var(--bg-panel); 
            padding: 8px 15px; 
            border-radius: 6px 6px 0 0; 
            cursor: pointer; 
            font-size: 14px; 
            color: var(--text-muted); 
            transition: 0.2s; 
        }

        .play-tab.active { 
            background: var(--primary); 
            color: white; 
            font-weight: bold; 
        }

        .play-tab-add { 
            background: transparent; 
            color: var(--accent); 
            padding: 8px 12px; 
            cursor: pointer; 
            font-weight: bold; 
            border-radius: 6px; 
        }
        
        .roster-container { 
            display: flex; 
            gap: 10px; 
            margin-bottom: 15px; 
            overflow-x: auto; 
            padding-bottom: 10px; 
            min-height: 45px; 
            align-items: center; 
        }

        .player-chip { 
            display: flex; 
            align-items: center; 
            gap: 8px; 
            background: var(--primary); 
            padding: 5px 12px; 
            border-radius: 20px; 
            font-size: 13px; 
        }

        .player-chip.selected { 
            background: var(--warning); 
            color: #000; 
            font-weight: bold; 
            border: 2px solid white; 
        }

        .action-icon { 
            cursor: pointer; 
            opacity: 0.7; 
            font-size: 12px; 
        } 

        .action-icon:hover { 
            opacity: 1; 
            color: white; 
        }
        
        /* Medio Campo CSS Realista */
        .field-map { 
            width: 100%; 
            height: 320px; 
            background-color: #1a5c31; 
            border: 3px solid white; 
            border-bottom: 8px solid white; 
            position: relative; 
            overflow: hidden; 
            background-image: linear-gradient(to bottom, rgba(255,255,255,0.4) 2px, transparent 2px), linear-gradient(to right, transparent 48%, rgba(255,255,255,0.2) 48%, rgba(255,255,255,0.2) 52%, transparent 52%); 
            background-size: 100% 20%, 100% 100%; 
        }

        .position-node { 
            position: absolute; 
            width: 45px; 
            height: 45px; 
            background: rgba(0,0,0,0.8); 
            border: 2px dashed rgba(255,255,255,0.6); 
            border-radius: 50%; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            color: white; 
            font-size: 11px; 
            font-weight: bold; 
            cursor: grab; 
            text-align: center; 
        }

        .position-node.assigned { 
            background: var(--primary); 
            border: 2px solid white; 
        }
    &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;

&lt;div class=&quot;app-container&quot;&gt;
    &lt;header&gt;
        &lt;div class=&quot;logo&quot;&gt;&lt;i class=&quot;fa-solid fa-football&quot;&gt;&lt;/i&gt; PlayTracker&lt;/div&gt;
        &lt;div class=&quot;user-controls&quot; id=&quot;user-controls&quot;&gt;
            &lt;span id=&quot;user-name&quot; style=&quot;font-weight:bold; color:var(--primary);&quot;&gt;&lt;/span&gt;
            &lt;button class=&quot;btn-logout&quot; onclick=&quot;cerrarSesion()&quot;&gt;Salir&lt;/button&gt;
        &lt;/div&gt;
    &lt;/header&gt;

    &lt;div id=&quot;login-view&quot;&gt;
        &lt;div class=&quot;login-box&quot; id=&quot;form-login&quot;&gt;
            &lt;h2 style=&quot;margin-bottom:20px;&quot;&gt;Acceso al Sistema&lt;/h2&gt;
            &lt;input type=&quot;text&quot; id=&quot;log-username&quot; placeholder=&quot;Usuario&quot;&gt;
            &lt;input type=&quot;password&quot; id=&quot;log-password&quot; placeholder=&quot;Contraseña&quot;&gt;
            &lt;button onclick=&quot;iniciarSesion()&quot;&gt;Entrar&lt;/button&gt;
            &lt;span class=&quot;toggle-link&quot; onclick=&quot;toggleAuth()&quot;&gt;¿Coach nuevo? Registra tu Equipo&lt;/span&gt;
            &lt;p id=&quot;log-error&quot; class=&quot;alert-msg&quot; style=&quot;color:var(--danger);&quot;&gt;&lt;/p&gt;
        &lt;/div&gt;
        
        &lt;div class=&quot;login-box&quot; id=&quot;form-register&quot; style=&quot;display:none;&quot;&gt;
            &lt;h2 style=&quot;margin-bottom:20px;&quot;&gt;Registro de Franquicia&lt;/h2&gt;
            &lt;input type=&quot;text&quot; id=&quot;reg-nombre&quot; placeholder=&quot;Tu Nombre (Head Coach)&quot;&gt;
            &lt;input type=&quot;text&quot; id=&quot;reg-equipo&quot; placeholder=&quot;Nombre Oficial del Equipo&quot;&gt;
            &lt;input type=&quot;text&quot; id=&quot;reg-username&quot; placeholder=&quot;Usuario de acceso&quot;&gt;
            &lt;input type=&quot;password&quot; id=&quot;reg-password&quot; placeholder=&quot;Contraseña&quot;&gt;
            &lt;button onclick=&quot;registrarCoach()&quot;&gt;Crear Equipo&lt;/button&gt;
            &lt;span class=&quot;toggle-link&quot; onclick=&quot;toggleAuth()&quot;&gt;Ya registré mi equipo. Iniciar Sesión&lt;/span&gt;
            &lt;p id=&quot;reg-msg&quot; class=&quot;alert-msg&quot;&gt;&lt;/p&gt;
        &lt;/div&gt;
    &lt;/div&gt;





&lt;!-- PANEL PRINCIPAL DEL SISTEMA --&gt;
    &lt;div id=&quot;dashboard-view&quot;&gt;
        
        &lt;div class=&quot;column-left&quot;&gt;
            
            &lt;!-- PANEL ADMINISTRADOR DE LIGA --&gt;
            &lt;div id=&quot;panel-admin&quot; style=&quot;display:none;&quot;&gt;
                
                &lt;!-- Agendar Partido --&gt;
                &lt;div class=&quot;card&quot; style=&quot;border-left: 4px solid #8b5cf6;&quot;&gt;
                    &lt;div class=&quot;card-header&quot;&gt;&lt;i class=&quot;fa-solid fa-crown&quot; style=&quot;color:#8b5cf6;&quot;&gt;&lt;/i&gt; Programar Partido Oficial&lt;/div&gt;
                    &lt;div style=&quot;display:flex; gap:10px;&quot;&gt;
                        &lt;div class=&quot;form-group&quot; style=&quot;flex:1;&quot;&gt;
                            &lt;label&gt;Equipo Local&lt;/label&gt;
                            &lt;select id=&quot;admin-eq-local&quot; class=&quot;form-control combo-equipos&quot;&gt;&lt;/select&gt;
                        &lt;/div&gt;
                        &lt;div class=&quot;form-group&quot; style=&quot;flex:1;&quot;&gt;
                            &lt;label&gt;Equipo Visitante&lt;/label&gt;
                            &lt;select id=&quot;admin-eq-visita&quot; class=&quot;form-control combo-equipos&quot;&gt;&lt;/select&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                    &lt;div class=&quot;form-group&quot;&gt;
                        &lt;label&gt;Fecha y Hora&lt;/label&gt;
                        &lt;input type=&quot;datetime-local&quot; id=&quot;admin-fecha&quot; class=&quot;form-control&quot;&gt;
                    &lt;/div&gt;
                    &lt;div class=&quot;form-group&quot;&gt;
                        &lt;label&gt;Sede (Montemorelos)&lt;/label&gt;
                        &lt;select id=&quot;admin-mapa&quot; class=&quot;form-control&quot;&gt;
                            &lt;option value=&quot;https://maps.app.goo.gl/Armi9rCLYaV3CbnP9?g_st=ac&quot;&gt;Ecoparque Pilón&lt;/option&gt;
                            &lt;option value=&quot;https://maps.app.goo.gl/xeDZp7hknHCGzfLR9?g_st=ac&quot;&gt;Deportivo Oriente&lt;/option&gt;
                            &lt;option value=&quot;https://maps.app.goo.gl/rs8umgYnoJajoi16A?g_st=ac&quot;&gt;Los Pavorreales&lt;/option&gt;
                        &lt;/select&gt;
                    &lt;/div&gt;
                    &lt;button class=&quot;btn-submit&quot; onclick=&quot;crearEvento(&#39;Partido&#39;, &#39;admin&#39;)&quot; style=&quot;background:#8b5cf6; color:white;&quot;&gt;Agendar Partido&lt;/button&gt;
                    &lt;p id=&quot;admin-msg&quot; class=&quot;alert-msg&quot;&gt;&lt;/p&gt;
                &lt;/div&gt;
                
                &lt;!-- Registrar Marcadores --&gt;
                &lt;div class=&quot;card&quot; style=&quot;border-left: 4px solid var(--warning);&quot;&gt;
                    &lt;div class=&quot;card-header&quot;&gt;&lt;i class=&quot;fa-solid fa-pen-to-square&quot; style=&quot;color:var(--warning);&quot;&gt;&lt;/i&gt; Registrar Marcador Final&lt;/div&gt;
                    &lt;div style=&quot;display:flex; gap:10px;&quot;&gt;
                        &lt;div class=&quot;form-group&quot; style=&quot;flex:1;&quot;&gt;
                            &lt;label&gt;Eq. Local&lt;/label&gt;
                            &lt;select id=&quot;res-eq-local&quot; class=&quot;form-control combo-equipos&quot;&gt;&lt;/select&gt;
                            &lt;input type=&quot;number&quot; id=&quot;res-pts-local&quot; class=&quot;form-control&quot; placeholder=&quot;Pts&quot; style=&quot;margin-top:5px;&quot;&gt;
                        &lt;/div&gt;
                        &lt;div class=&quot;form-group&quot; style=&quot;flex:1;&quot;&gt;
                            &lt;label&gt;Eq. Visitante&lt;/label&gt;
                            &lt;select id=&quot;res-eq-visita&quot; class=&quot;form-control combo-equipos&quot;&gt;&lt;/select&gt;
                            &lt;input type=&quot;number&quot; id=&quot;res-pts-visita&quot; class=&quot;form-control&quot; placeholder=&quot;Pts&quot; style=&quot;margin-top:5px;&quot;&gt;
                        &lt;/div&gt;
                    &lt;/div&gt;
                    &lt;button class=&quot;btn-submit&quot; onclick=&quot;registrarResultado()&quot; style=&quot;background:var(--warning); color:#000;&quot;&gt;Actualizar Tabla&lt;/button&gt;
                    &lt;p id=&quot;res-msg&quot; class=&quot;alert-msg&quot;&gt;&lt;/p&gt;
                    &lt;div class=&quot;history-list&quot; id=&quot;lista-historial&quot;&gt;&lt;/div&gt;
                &lt;/div&gt;

                &lt;!-- ZONA DE PELIGRO ADMIN --&gt;
                &lt;div class=&quot;card&quot; style=&quot;border-left: 4px solid var(--danger);&quot;&gt;
                    &lt;div class=&quot;card-header&quot;&gt;&lt;i class=&quot;fa-solid fa-triangle-exclamation&quot; style=&quot;color:var(--danger);&quot;&gt;&lt;/i&gt; Gestión de Liga (Zona de Peligro)&lt;/div&gt;
                    &lt;p style=&quot;font-size:12px; color:var(--text-muted); margin-bottom:10px;&quot;&gt;Equipos Inscritos y Coaches:&lt;/p&gt;
                    &lt;div class=&quot;history-list&quot; id=&quot;admin-lista-equipos&quot; style=&quot;margin-bottom: 20px;&quot;&gt;&lt;/div&gt;
                    &lt;div style=&quot;display:flex; gap:10px;&quot;&gt;
                        &lt;button class=&quot;btn-undo&quot; onclick=&quot;reiniciarTemporada()&quot; style=&quot;flex:1;&quot;&gt;Reiniciar Tabla a Cero&lt;/button&gt;
